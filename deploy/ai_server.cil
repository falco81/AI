; ai - what SELinux needs for ai that the system's policy does not say (1.0.91, after otp's otp_server).
; Installed by install.sh and by every upgrade (semodule -i ai_server.cil), taken away with
; semodule -r ai_server. Labels first; a narrow rule only where no label or boolean does it, each
; in a block of its own.
;
; /run/ai holds the daemon's API token. The pages (php-fpm, httpd_t) read it; made by systemd as
; var_run_t, httpd_t may not read it. Labelled as the web server's own run files, which httpd_t
; reads; the daemon (unconfined_service_t, root) writes it as before.
;
; Both spellings: the policy reads a path through file_contexts.subs_dist first - on RHEL 8 "/run"
; is looked up as "/var/run", on newer policies the other way round - so a rule for one of them
; alone may never be matched. The one never looked up does nothing.
(filecon "/run/ai" dir (system_u object_r httpd_var_run_t ((s0) (s0))))
(filecon "/run/ai/.*" any (system_u object_r httpd_var_run_t ((s0) (s0))))
(filecon "/var/run/ai" dir (system_u object_r httpd_var_run_t ((s0) (s0))))
(filecon "/var/run/ai/.*" any (system_u object_r httpd_var_run_t ((s0) (s0))))

; systemd hands /run/ai (RuntimeDirectory=ai) over before every command of the unit - ExecReload
; too: it may change the owner and the mode of what is in it. Seen under otp as
; "init_t -> httpd_var_run_t file { setattr }". Only that: no read, no write. In a block of its
; own, so that a policy without one of the types still takes the rest of the module.
(optional ai_server_systemd_runtime
    (allow init_t httpd_var_run_t (dir (getattr setattr search open read)))
    (allow init_t httpd_var_run_t (file (getattr setattr))))
